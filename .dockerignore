# Ignore node_modules to ensure native modules are compiled for the container's architecture
server/node_modules
node_modules

# Ignore local environment files (already mounted as volume)
server/.env.local
.env.local

# Ignore git files
.git
.gitignore

# Ignore documentation and other non-essential files
*.md
LICENSE

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore build artifacts and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
