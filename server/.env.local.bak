# Primary API origin (used for docs/certs)
API_ORIGIN=http://10.0.1.218 # your local server IP address if self hosting

# Listener ports
PROXY_PORT=9543 # 80 for HTTP, 443 for HTTPS
CONTROL_PORT=8081

# Convex deployment
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:9755
CONVEX_SELF_HOSTED_ADMIN_KEY=local|019ee42c8179bc04dc4a6652317469b6911d30b2bf4ea6629c82635bee5532cd7e854a8f86
CONVEX_ADMIN_KEY=local|019ee42c8179bc04dc4a6652317469b6911d30b2bf4ea6629c82635bee5532cd7e854a8f86


# Entry key lifetime (seconds)
ENTRY_KEY_TTL_SECONDS=3600

# Debug logging (logs all requests and responses to console)
# Set to true to enable
DEBUG_LOGGING=true

# Deployment used by `npx convex dev`
#CONVEX_DEPLOYMENT=anonymous:anonymous-frontend

CONVEX_URL=http://127.0.0.1:9755
